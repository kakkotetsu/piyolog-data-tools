          "options": { "include": { "names": ["meal_time", "memo"] } }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "meal_time", "destinationType": "time" }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "meal_time": 0,
              "memo": 1
            },
            "renameByName": {
              "meal_time": "日時",
              "memo": "メモ"
            }
          }
        }
